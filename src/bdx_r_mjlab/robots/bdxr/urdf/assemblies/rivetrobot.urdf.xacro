    <!-- Joints (internal to assembly) -->
    <joint name="Right_Hip_Yaw" type="revolute">
      <parent link="base_link"/>
      <child link="Yaw_R"/>
      <origin xyz="-0.103104 -0.060000 0.011836" rpy="0.000000 0.000000 0.000000"/>
      <axis xyz="0.000000 0.000000 1.000000"/>
      <limit lower="-0.261799" upper="0.349066" effort="100.0" velocity="1.00"/>
